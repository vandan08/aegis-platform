# Copy to deploy/.env and fill in. Never commit the filled-in file.
#
# Both hostnames must already resolve to this server's public IP (an A record each)
# before the stack starts: Caddy proves control of them over HTTP to get a certificate,
# and that check runs at startup.

# Public hostname for the gateway — the demo console lives here.
AEGIS_APP_HOST=app.example.com
# Public hostname for the authorization server.
AEGIS_AUTH_HOST=auth.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Postgres credentials. Generate, do not invent:  openssl rand -base64 24
DB_USERNAME=aegis
DB_PASSWORD=replace-me-with-a-generated-secret

# The sandbox account shown on the demo console. Anyone with the URL can sign in as this
# user, so keep it a plain non-admin account and treat the password as public.
# The seeded admin (admin/changeit) is NOT shown on the console — change it after the
# first deploy if the site is publicly linked.
AEGIS_DEMO_USER=alice
AEGIS_DEMO_PASSWORD=aegis-demo-2026
